# Docker ortamı için environment değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.docker .env

# ZORUNLU: Güçlü, rastgele bir JWT secret belirleyin.
# Backend, üretimde (NODE_ENV=production) boş veya varsayılan/zayıf bir secret
# ile BAŞLAMAYI REDDEDER. Aşağıdaki satırı gerçek bir değerle değiştirin.
# Üretmek için:  openssl rand -base64 48
JWT_SECRET=

# Uygulamaya dışarıdan erişilecek URL (sunucu IP veya domain)
# QR kodlarda kullanılır
PUBLIC_APP_URL=http://localhost:3002

# Admin panelinin adresi (CORS için)
ADMIN_PANEL_URL=http://localhost:3001

# HTTPS arkasında çalıştırıyorsanız true yapın (Secure cookie).
COOKIE_SECURE=false
