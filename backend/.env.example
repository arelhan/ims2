DATABASE_URL="file:./dev.db"
# `npm run setup` auto-generates a strong random value here.
# In production the server refuses to start with an empty/default/weak secret.
JWT_SECRET="change-this-to-a-secure-random-string"
PORT=4000
ADMIN_PANEL_URL="http://localhost:3001"
# Leave empty to auto-detect server IP for QR codes, or set explicitly:
PUBLIC_APP_URL=""
PUBLIC_APP_PORT=3002
# Set to "true" when served over HTTPS so the auth cookie gets the Secure flag.
COOKIE_SECURE="false"
